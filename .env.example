# business-workspace environment variables
# Copy to .env.local and fill in values

# PostgreSQL (Docker) — pnpm start spins up the container automatically
POSTGRES_PASSWORD=        # generate: openssl rand -base64 24 | tr -dc 'a-zA-Z0-9' | head -c 32
POSTGRES_PORT=5433        # default 5433 to avoid conflicts with local postgres
POSTGRES_BIND_ADDRESS=0.0.0.0  # default network-reachable; use 127.0.0.1 for local-only access
DATABASE_URL=postgresql://workspace:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/workspace?sslmode=require&uselibpqcompat=true

# External Access (optional) — enables remote AI agent connections
# Get a free token at https://www.duckdns.org
DUCKDNS_TOKEN=
DUCKDNS_SUBDOMAIN=          # e.g. "my-workspace" → my-workspace.duckdns.org

# AI
OPENROUTER_API_KEY=

# Pulse
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
X_API_BEARER_TOKEN=
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=

# Signal Discovery APIs
PARALLEL_API_KEY=
THEIRSTACK_API_KEY=
EXA_API_KEY=

# Contact Enrichment APIs
LEADMAGIC_API_KEY=
FULLENRICH_API_KEY=

# Outreach APIs
UNIPILE_API_KEY=
UNIPILE_DSN=

# Signal Discovery APIs
PARALLEL_API_KEY=
THEIRSTACK_API_KEY=
EXA_API_KEY=

# Contact Enrichment APIs
LEADMAGIC_API_KEY=
FULLENRICH_API_KEY=

# Outreach APIs
UNIPILE_API_KEY=
UNIPILE_DSN=
